# Runtime identity
APP_ENV=local
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000

# Data and sessions
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nevely
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional dedicated shared key for N5.2 message-signal buckets. If omitted,
# SESSION_SECRET is used. Keep the selected value identical across replicas.
MODERATION_MESSAGE_HMAC_KEY=replace-with-a-separate-high-entropy-secret
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-a-separate-high-entropy-secret

# One-time first administrator bootstrap. Keep disabled and remove the target
# and confirmation immediately after the command succeeds.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_CONFIRM=

# Railway supplies these automatically in deployed environments.
RAILWAY_ENVIRONMENT_NAME=
RAILWAY_ENVIRONMENT_ID=
PRODUCTION_RAILWAY_ENVIRONMENT_ID=

# Email. Staging must use test mode and a @resend.dev recipient.
EMAIL_DELIVERY_MODE=disabled
RESEND_API_KEY=
RESEND_FROM=Verify <noreply@notifications.nevely.app>
RESEND_TEST_RECIPIENT=delivered+staging@resend.dev

# Google Identity Services. Use distinct web client IDs for staging and production.
GOOGLE_CLIENT_ID=

# Public support contact shown in product copy.
SUPPORT_EMAIL=support@nevely.app

# Analytics and indexing stay disabled outside production.
ANALYTICS_MODE=disabled
ROBOTS_INDEXING=disabled

# Temporary production access gate. Set false to disable it without removing the hash.
PRIVATE_PREVIEW_ENABLED=false
PRIVATE_PREVIEW_PASSWORD_HASH=

# Release lifecycle; see railway.json and docs/release/health-and-draining.md.
SHUTDOWN_GRACE_MS=25000

# N2 retention and capacity. These defaults are built into the application;
# override them only for a reviewed operational reason.
RETENTION_WORKER_ENABLED=true
RETENTION_INTERVAL_MS=21600000
RETENTION_BATCH_SIZE=500
RETENTION_MAX_BATCHES_PER_POLICY=20
RETENTION_MAX_UNSAVED_PER_USER=50
DATABASE_BUDGET_BYTES=5368709120
CAPACITY_ALERT_EMAIL=admin@nevely.app
