<%- include('partials/header', { hideSiteHeader: true }) %>
<main class="auth-page auth-page--action">
  <section class="auth-shell auth-shell--action" aria-labelledby="profile-completion-title">
    <div class="auth-entry">
      <header class="auth-entry__header">
        <p class="auth-kicker"><%= copy.auth.completeProfileEyebrow %></p>
        <h1 id="profile-completion-title"><%= copy.auth.completeProfileTitle %></h1>
        <p><%= copy.auth.completeProfileBody %></p>
      </header>
      <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
      <form class="auth-form" method="post" action="/complete-profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="auth-field">
          <span><%= copy.auth.birthDate %></span>
          <span class="auth-field-shell">
            <i data-lucide="calendar-days" aria-hidden="true"></i>
            <input name="birthDate" type="date" autocomplete="bday" required
                   value="<%= values?.birthDate || '' %>">
          </span>
        </label>
        <label class="auth-field">
          <span><%= copy.common.gender %></span>
          <span class="auth-choice-group" data-gender-choices>
            <select name="gender" class="profile-native-control" aria-hidden="true" tabindex="-1">
              <option value=""><%= copy.auth.selectGender %></option>
              <option value="female" <%= values?.gender === 'female' ? 'selected' : '' %>><%= copy.common.female %></option>
              <option value="male" <%= values?.gender === 'male' ? 'selected' : '' %>><%= copy.common.male %></option>
              <option value="non-binary" <%= values?.gender === 'non-binary' ? 'selected' : '' %>><%= copy.common.nonBinary %></option>
              <option value="other" <%= values?.gender === 'other' ? 'selected' : '' %>><%= copy.common.other %></option>
              <option value="prefer-not-to-say" <%= values?.gender === 'prefer-not-to-say' ? 'selected' : '' %>><%= copy.auth.preferNotToSay %></option>
            </select>
            <span class="auth-choice-list" role="group" aria-label="<%= copy.common.gender %>" aria-required="true">
              <button class="auth-choice" type="button" data-choice-value="female"><%= copy.common.female %></button>
              <button class="auth-choice" type="button" data-choice-value="male"><%= copy.common.male %></button>
              <button class="auth-choice" type="button" data-choice-value="non-binary"><%= copy.common.nonBinary %></button>
              <button class="auth-choice" type="button" data-choice-value="other"><%= copy.common.other %></button>
              <button class="auth-choice" type="button" data-choice-value="prefer-not-to-say"><%= copy.auth.preferNotToSay %></button>
            </span>
          </span>
        </label>
        <label class="auth-field" for="profile-country-search">
          <span><%= copy.common.country %></span>
          <span class="auth-country-combobox" data-country-combobox>
            <span class="auth-field-shell">
              <i data-lucide="map-pin" aria-hidden="true"></i>
              <input id="profile-country-search" type="search" autocomplete="off" placeholder="<%= copy.chat.guestPassport.countryPlaceholder %>" role="combobox" aria-autocomplete="list" aria-controls="profile-country-suggestions" aria-expanded="false" aria-required="true">
            </span>
            <select name="countryCode" class="profile-native-control" aria-hidden="true" tabindex="-1">
              <option value=""><%= copy.auth.selectCountry %></option>
              <% countries.forEach((country) => { %>
                <option value="<%= country.code %>" <%= values?.countryCode === country.code ? 'selected' : '' %>><%= country.name %></option>
              <% }) %>
            </select>
            <span class="auth-country-suggestions hidden" id="profile-country-suggestions" role="listbox" aria-label="<%= copy.chat.match.countryResultsAria %>"></span>
          </span>
        </label>
        <button class="auth-submit" type="submit"><%= copy.auth.completeProfileAction %></button>
      </form>
    </div>
  </section>
</main>
<script src="/js/profile-fields.js"></script>
<%- include('partials/footer') %>
