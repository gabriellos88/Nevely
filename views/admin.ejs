<%- include('partials/header') %>
<main class="admin-page">
  <div class="admin-wrap">
    <h1><%= copy.admin.title %></h1>
    <section class="admin-section">
      <h2><%= copy.admin.reauthenticateTitle %></h2>
      <p><%= adminReauthMethod === 'google'
        ? copy.admin.reauthenticateGoogleBody
        : copy.admin.reauthenticateBody %></p>
      <% if (adminReauthMethod !== 'unavailable') { %>
      <form class="admin-price-form" id="adminReauthForm"
            data-reauth-method="<%= adminReauthMethod %>">
        <% if (adminReauthMethod === 'password') { %>
          <input name="password" type="password" autocomplete="current-password" required
                 placeholder="<%= copy.common.password %>">
        <% } %>
        <input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
               autocomplete="one-time-code" required placeholder="<%= copy.auth.twoFactorCode %>">
        <% if (adminReauthMethod === 'password') { %>
          <button class="btn btn-primary" type="submit"><%= copy.admin.reauthenticateAction %></button>
        <% } %>
      </form>
      <% if (adminReauthMethod === 'google') { %>
        <div id="g_id_onload"
             data-client_id="<%= googleClientId %>"
             data-callback="handleAdminGoogleReauth"
             data-nonce="<%= adminGoogleNonce %>"
             data-auto_prompt="false"
             data-cancel_on_tap_outside="true"></div>
        <div class="g_id_signin"
             data-type="standard"
             data-shape="pill"
             data-theme="filled_black"
             data-text="continue_with"
             data-size="large"
             data-logo_alignment="left"></div>
      <% } %>
      <% } else { %>
        <p role="alert"><%= copy.admin.reauthenticateUnavailable %></p>
      <% } %>
      <p id="adminReauthFeedback" role="status" aria-live="polite"></p>
    </section>
    <section class="admin-section">
      <h2><%= copy.admin.reports %></h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th><%= copy.admin.date %></th><th><%= copy.admin.reporter %></th><th><%= copy.admin.reported %></th><th><%= copy.admin.reason %></th><th><%= copy.admin.status %></th><th><%= copy.admin.actions %></th></tr></thead>
          <tbody>
            <% reports.forEach((report) => { %>
              <tr><td><%= new Date(report.created_at).toLocaleString() %></td><td><%= report.reporter_name || copy.common.guest %></td><td><%= report.reported_name || copy.common.guest %></td><td><%= report.reason %></td><td><%= report.status %></td><td><% if (report.status === 'pending') { %><button class="admin-action" data-report-action="resolve" data-id="<%= report.id %>"><%= copy.admin.resolve %></button><button class="admin-action" data-report-action="dismiss" data-id="<%= report.id %>"><%= copy.admin.dismiss %></button><% } %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
    <section class="admin-section">
      <h2><%= copy.admin.users %></h2>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead><tr><th><%= copy.admin.id %></th><th><%= copy.admin.name %></th><th><%= copy.admin.email %></th><th><%= copy.admin.role %></th><th><%= copy.admin.plan %></th><th><%= copy.admin.actions %></th></tr></thead>
          <tbody>
            <% users.forEach((user) => { %>
              <tr><td><%= user.public_id %></td><td><%= user.display_name %></td><td><%= user.email %></td><td><%= user.role %></td><td><%= user.plan %></td><td><button class="admin-action" data-ban="temporary" data-id="<%= user.public_id %>"><%= copy.admin.banDay %></button><button class="admin-action danger" data-ban="permanent" data-id="<%= user.public_id %>"><%= copy.admin.banPermanent %></button><button class="admin-action danger" data-delete-user data-id="<%= user.public_id %>"><%= copy.admin.banDelete %></button></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
    <section class="admin-section">
      <h2><%= copy.admin.premiumPlan %></h2>
      <p><%= copy.admin.currentPrice %>: <strong><%= price ? (price.price_cents / 100).toFixed(2) + ' ' + price.currency : '0.00 USD' %></strong></p>
      <form class="admin-price-form" id="adminPriceForm"><input name="price" type="number" min="0" step="0.01" value="<%= price ? (price.price_cents / 100).toFixed(2) : '0.00' %>"><select name="currency"><option>USD</option><option>EUR</option><option>CHF</option></select><button class="btn btn-primary" type="submit"><%= copy.admin.savePrice %></button></form>
    </section>
  </div>
</main>
<script nonce="<%= cspNonce %>">
  window.__COPY__ = <%- JSON.stringify(copy).replace(/</g, '\\u003c') %>;
  window.__ADMIN_CONFIG__ = <%- JSON.stringify({
    csrfToken,
    reauthMethod: adminReauthMethod
  }).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/admin.js"></script>
<% if (adminReauthMethod === 'google') { %>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<%- include('partials/footer') %>
